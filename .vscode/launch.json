{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "STM32F103 Debug",
            "type": "cortex-debug",
            "request": "launch",
            // "keepTimersRunning": false,
            "servertype": "openocd",
            // 指向你編譯出來的 .elf 檔案（請與你的專案名稱對齊）
            "executable": "${workspaceRoot}/build/Debug/stm32f103project.elf", 
            
            // 指向你那包 gnu 裡面的 openocd 與 arm-none-eabi-gdb
            "serverpath": "C:/FreeRTOS/stm32f103/stm32f103project/gnu/OpenOCD-20260121-0.12.0/bin/openocd.exe",
            "armToolchainPath": "C:/FreeRTOS/stm32f103/stm32f103project/gnu/bin",
            
            // 對齊正點原子的 stlink 燒錄器與 F103 晶片
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],
            "preLaunchTask": "CMake: build", // 偵錯前會自動幫你重新編譯最新代碼
            "runToEntryPoint": "main",      // 開機自動停在 main 函式第一行等你想好再跑
            "cwd": "${workspaceRoot}"
        }
    ]
}